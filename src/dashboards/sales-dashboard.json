        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH funnel_data AS (SELECT COUNT(DISTINCT actor_id) as visitors, 'Visitor' as stage FROM public.activity_log WHERE action = 'page_view' AND created_at >= NOW() - INTERVAL '30 days' UNION ALL SELECT COUNT(DISTINCT actor_id), 'Search' FROM public.activity_log WHERE action = 'search' AND created_at >= NOW() - INTERVAL '30 days' UNION ALL SELECT COUNT(DISTINCT actor_id), 'Cart' FROM public.activity_log WHERE action = 'add_to_cart' AND created_at >= NOW() - INTERVAL '30 days' UNION ALL SELECT COUNT(DISTINCT actor_id), 'Checkout' FROM public.activity_log WHERE action = 'checkout_started' AND created_at >= NOW() - INTERVAL '30 days' UNION ALL SELECT COUNT(DISTINCT actor_id), 'Order' FROM public.activity_log WHERE action = 'order_completed' AND created_at >= NOW() - INTERVAL '30 days' UNION ALL SELECT COUNT(DISTINCT actor_id), 'Paid' FROM public.activity_log WHERE action = 'payment_completed' AND created_at >= NOW() - INTERVAL '30 days') SELECT * FROM funnel_data ORDER BY visitors DESC;",
          "refId": "A"
        }
      ],
      "title": "Conversion Funnel (30 days)",
      "type": "timeseries"
    }
