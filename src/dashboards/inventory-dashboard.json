      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(details->>'product_name', 'Unknown') as product, COALESCE(CAST(details->>'stock_level' AS NUMERIC), 0) as current_stock, COALESCE(CAST(details->>'min_stock' AS NUMERIC), 0) as min_stock, CASE WHEN CAST(details->>'stock_level' AS NUMERIC) < CAST(details->>'min_stock' AS NUMERIC) THEN 'Critical' WHEN CAST(details->>'stock_level' AS NUMERIC) < CAST(details->>'min_stock' AS NUMERIC) * 1.5 THEN 'Warning' ELSE 'Good' END as health_status FROM public.activity_log WHERE action = 'stock_checked' AND created_at >= (SELECT MAX(created_at) FROM public.activity_log WHERE action = 'stock_checked') ORDER BY health_status;",
          "refId": "A"
        }
      ],
      "title": "Stock Health Heatmap",
      "type": "table"
