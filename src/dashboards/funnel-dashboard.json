        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH funnel AS (SELECT COUNT(DISTINCT actor_id) as visitors FROM public.activity_log WHERE action = 'page_view' AND created_at >= NOW() - INTERVAL '30 days'), search_stage AS (SELECT COUNT(DISTINCT actor_id) as searchers FROM public.activity_log WHERE action = 'search' AND created_at >= NOW() - INTERVAL '30 days'), cart_stage AS (SELECT COUNT(DISTINCT actor_id) as cart_users FROM public.activity_log WHERE action = 'add_to_cart' AND created_at >= NOW() - INTERVAL '30 days'), checkout_stage AS (SELECT COUNT(DISTINCT actor_id) as checkout_users FROM public.activity_log WHERE action = 'checkout_started' AND created_at >= NOW() - INTERVAL '30 days'), order_stage AS (SELECT COUNT(DISTINCT actor_id) as order_users FROM public.activity_log WHERE action = 'order_completed' AND created_at >= NOW() - INTERVAL '30 days') SELECT 'Visitor→Search' as stage, ROUND(100.0 * (1 - (SELECT searchers FROM search_stage)::FLOAT / NULLIF((SELECT visitors FROM funnel)::FLOAT, 0)), 2) as dropout_rate UNION ALL SELECT 'Search→Cart', ROUND(100.0 * (1 - (SELECT cart_users FROM cart_stage)::FLOAT / NULLIF((SELECT searchers FROM search_stage)::FLOAT, 0)), 2) UNION ALL SELECT 'Cart→Checkout', ROUND(100.0 * (1 - (SELECT checkout_users FROM checkout_stage)::FLOAT / NULLIF((SELECT cart_users FROM cart_stage)::FLOAT, 0)), 2) UNION ALL SELECT 'Checkout→Order', ROUND(100.0 * (1 - (SELECT order_users FROM order_stage)::FLOAT / NULLIF((SELECT checkout_users FROM checkout_stage)::FLOAT, 0)), 2) ORDER BY dropout_rate DESC;",
          "refId": "A"
        }
      ],
      "title": "Dropout Analysis",
      "type": "timeseries"
    },
