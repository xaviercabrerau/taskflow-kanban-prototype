        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH funnel AS (SELECT COUNT(DISTINCT actor_id) as visitors FROM public.activity_log WHERE action = 'page_view' AND created_at >= NOW() - INTERVAL '30 days'), search_stage AS (SELECT COUNT(DISTINCT actor_id) as searchers FROM public.activity_log WHERE action = 'search' AND created_at >= NOW() - INTERVAL '30 days'), cart_stage AS (SELECT COUNT(DISTINCT actor_id) as cart_users FROM public.activity_log WHERE action = 'add_to_cart' AND created_at >= NOW() - INTERVAL '30 days'), checkout_stage AS (SELECT COUNT(DISTINCT actor_id) as checkout_users FROM public.activity_log WHERE action = 'checkout_started' AND created_at >= NOW() - INTERVAL '30 days'), order_stage AS (SELECT COUNT(DISTINCT actor_id) as order_users FROM public.activity_log WHERE action = 'order_completed' AND created_at >= NOW() - INTERVAL '30 days'), paid_stage AS (SELECT COUNT(DISTINCT actor_id) as paid_users FROM public.activity_log WHERE action = 'payment_completed' AND created_at >= NOW() - INTERVAL '30 days') SELECT 'Visitor' as stage, (SELECT visitors FROM funnel) as users, 100.0 as conversion_pct UNION ALL SELECT 'Search', (SELECT searchers FROM search_stage), ROUND(100.0 * (SELECT searchers FROM search_stage) / NULLIF((SELECT visitors FROM funnel), 0), 2) UNION ALL SELECT 'Cart', (SELECT cart_users FROM cart_stage), ROUND(100.0 * (SELECT cart_users FROM cart_stage) / NULLIF((SELECT visitors FROM funnel), 0), 2) UNION ALL SELECT 'Checkout', (SELECT checkout_users FROM checkout_stage), ROUND(100.0 * (SELECT checkout_users FROM checkout_stage) / NULLIF((SELECT visitors FROM funnel), 0), 2) UNION ALL SELECT 'Order', (SELECT order_users FROM order_stage), ROUND(100.0 * (SELECT order_users FROM order_stage) / NULLIF((SELECT visitors FROM funnel), 0), 2) UNION ALL SELECT 'Paid', (SELECT paid_users FROM paid_stage), ROUND(100.0 * (SELECT paid_users FROM paid_stage) / NULLIF((SELECT visitors FROM funnel), 0), 2);",
          "refId": "A"
        }
      ],
      "title": "Customer Acquisition Funnel",
      "type": "table"
    },
