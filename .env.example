# ============================================================================
# TaskFlow Notification System - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your credentials
# For development: use test/sandbox credentials
# For production: use proper credentials from each service
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Obtain from: https://app.supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — never expose to frontend
# Only used in server-side code and scripts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# SLACK INTEGRATION
# ============================================================================
# Setup: https://api.slack.com/apps → Create New App → Incoming Webhooks

# Webhook URL for sending alerts and notifications to Slack
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Slack bot token for advanced operations
# Obtain from: https://api.slack.com/apps → OAuth & Permissions → Bot Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Optional: Slack app signing secret for webhook verification
# From: https://api.slack.com/apps → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================================================
# PAGERDUTY INTEGRATION
# ============================================================================
# Setup: https://www.pagerduty.com → Services → Create Service → Integrations

# Integration key for sending incidents to PagerDuty
# From: Service Details → Integrations → Add Integration (choose Events API V2)
# Format: 11111111-2222-3333-4444-555555555555
PAGERDUTY_INTEGRATION_KEY=11111111-2222-3333-4444-555555555555

# Optional: PagerDuty API token for advanced operations
# From: https://subdomain.pagerduty.com → Account Settings → API Access
PAGERDUTY_API_TOKEN=your-api-token-here

# PagerDuty base URL (change for EU region)
# US: https://events.pagerduty.com/v2/enqueue
# EU: https://events.eu.pagerduty.com/v2/enqueue
PAGERDUTY_BASE_URL=https://events.pagerduty.com/v2/enqueue

# ============================================================================
# TWILIO INTEGRATION (SMS Notifications)
# ============================================================================
# Setup: https://www.twilio.com → Account → Account SID & Auth Token

# Your Twilio Account SID
# From: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (keep secret!)
# From: https://www.twilio.com/console
TWILIO_AUTH_TOKEN=your-auth-token-here

# Your Twilio phone number (the "from" number for SMS)
# Format: +1234567890 (include country code)
TWILIO_FROM_NUMBER=+1234567890

# Optional: On-call engineer primary phone number for critical alerts
# Format: +1234567890
ON_CALL_PRIMARY_PHONE=+1234567890

# ============================================================================
# GMAIL API CONFIGURATION
# ============================================================================
# Setup: https://cloud.google.com/docs/authentication/getting-started

# Gmail API credentials (OAuth 2.0)
# From: Google Cloud Console → Credentials → Create OAuth 2.0 Client ID
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret-here

# Gmail refresh token (obtained via OAuth flow)
# Use: scripts/get-gmail-token.js to generate initial token
GMAIL_REFRESH_TOKEN=1//0gV... (very long string)

# Gmail service account credentials (alternative to OAuth)
# From: Google Cloud Console → Service Accounts → Create Service Account
# Content of service-account.json file (single line JSON or path to file)
GMAIL_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Gmail API token (access token, auto-refreshed by system)
GMAIL_API_TOKEN=ya29.a0... (auto-managed, do not set manually)

# ============================================================================
# SENTRY ERROR TRACKING
# ============================================================================
# Setup: https://sentry.io → Create Project → Select Runtime

# Sentry DSN for client-side error tracking
# From: Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry DSN for server-side error tracking
# From: Project Settings → Client Keys (DSN)
SENTRY_DSN=https://examplePrivateKey@o0.ingest.sentry.io/0

# Optional: Sentry auth token for CLI operations
SENTRY_AUTH_TOKEN=your-auth-token-here

# Sentry environment (development, staging, production)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ============================================================================
# APPLICATION URLs & DOMAINS
# ============================================================================
# All URLs should match your deployment environment

# Primary application URL (used for links in notifications)
# Development: http://localhost:3000
# Staging: https://staging.taskflow.app
# Production: https://taskflow.app
TASKFLOW_URL=http://localhost:3000

# Base URL for runbooks (documentation/operational procedures)
# Should point to your wiki/documentation system
RUNBOOK_BASE_URL=http://localhost:3000/docs/runbooks

# Base URL for API calls
API_BASE_URL=http://localhost:3000/api

# Vercel deployment URL (auto-set in production, for deployments)
VERCEL_URL=taskflow.vercel.app

# ============================================================================
# DATADOG MONITORING & ALERTING
# ============================================================================
# Setup: https://www.datadoghq.com → Integrations → APIs

# Datadog API key
# From: https://app.datadoghq.com/account/settings#api → API keys
DD_API_KEY=your-api-key-here

# Datadog application key
# From: https://app.datadoghq.com/account/settings#api → Application keys
DD_APP_KEY=your-app-key-here

# Datadog site (us3.datadoghq.com for US, datadoghq.eu for EU)
DD_SITE=datadoghq.com

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# For job queue and caching

# Redis connection URL
# Format: redis://[:password@]host:port/db
# Development: redis://localhost:6379/0
# Production: redis://prod-redis.example.com:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis host (used in monitoring/debugging scripts)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (if authentication required)
REDIS_PASSWORD=

# ============================================================================
# UPSTASH REDIS (Alternative to self-hosted Redis)
# ============================================================================
# Setup: https://upstash.com → Create Database

# REST API endpoint
UPSTASH_REDIS_REST_URL=https://example.upstash.io

# REST API token
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection URL (when using non-Supabase database)
DATABASE_URL=postgresql://user:password@localhost:5432/taskflow

# Supabase database admin user (for migrations)
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-password
SUPABASE_HOST=your-project.supabase.co
SUPABASE_PORT=5432

# ============================================================================
# CRON & WEBHOOKS
# ============================================================================

# Shared secret for Vercel Cron triggers
# Generate: openssl rand -base64 32
# Must match Vercel environment variable
CRON_SECRET=your-random-secret-here

# Webhook URL for receiving cron alerts
# This endpoint should handle alert check results
ALERT_WEBHOOK_URL=http://localhost:3000/api/webhooks/alert-check

# ============================================================================
# EMAIL CONFIGURATION & RECIPIENTS
# ============================================================================

# Alert email recipients (comma-separated list of email addresses)
ALERTS_EMAIL_RECIPIENTS=ops-team@company.com,engineering-lead@company.com

# Sender email address for alerts
ALERTS_FROM_ADDRESS=alerts@company.com

# Error digest recipient emails (daily/weekly summaries)
ERROR_DIGEST_EMAIL_RECIPIENTS=engineering-lead@company.com

# On-call engineer contact email
ON_CALL_EMAIL=oncall@company.com

# Engineering manager email
ENGINEERING_LEAD_EMAIL=engineering-lead@company.com

# Infrastructure team email
INFRASTRUCTURE_TEAM_EMAIL=infrastructure@company.com

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret for signing tokens (development only)
# Generate: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Debug JWT token (for testing authenticated endpoints)
# Generate using: npx ts-node scripts/generate-debug-token.ts
DEBUG_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API admin token (for protected admin endpoints)
API_ADMIN_TOKEN=your-admin-token-here

# ============================================================================
# FEATURE FLAGS & CONFIGURATION
# ============================================================================

# Enable/disable notification features
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=true
ENABLE_PAGERDUTY_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_IN_APP_NOTIFICATIONS=true

# Email configuration
EMAIL_CONCURRENCY=10
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MS=1000
EMAIL_POOL_SIZE=10

# ============================================================================
# ON-CALL & ESCALATION
# ============================================================================

# Primary on-call user ID (from your user management system)
PRIMARY_ON_CALL_USER_ID=user_123

# Secondary on-call user ID (escalation level 2)
SECONDARY_ON_CALL_USER_ID=user_456

# Engineering lead user ID (escalation level 3)
ENGINEERING_LEAD_USER_ID=user_789

# Engineering lead phone (for SMS escalation)
ENGINEERING_LEAD_PHONE=+1234567890

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable verbose logging (development)
VERBOSE_LOGGING=false

# Enable structured logging (JSON format)
STRUCTURED_LOGGING=true

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Environment: development, staging, production
NODE_ENV=development

# Enable mock services (for testing without real credentials)
USE_MOCK_SERVICES=false

# Mock service responses instead of calling real APIs
MOCK_SLACK=false
MOCK_PAGERDUTY=false
MOCK_GMAIL=false
MOCK_TWILIO=false
