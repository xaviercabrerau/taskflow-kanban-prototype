# ============================================================================
# TaskFlow — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your credentials.
# Only variables actually read by the app or its scripts are listed here —
# confirmed via `grep -r "process.env\." src/` + `requireEnv(...)` calls
# (Auditoría 2026-09-03, hallazgo 16: this file used to document ~90
# variables from a generic observability boilerplate — Slack, PagerDuty,
# Twilio, Datadog, self-hosted Redis, etc. — that this project never wired
# up, while missing several it actually needs. If you're building one of
# those integrations for real, add its variables here as you wire it in.)
# ============================================================================

# ============================================================================
# SUPABASE (required)
# ============================================================================
# Obtain from: https://app.supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — never expose to the frontend. Used server-side to bypass
# RLS for a handful of SECURITY DEFINER-style flows (notify.ts, google/client.ts,
# ai/client.ts, github/client.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Non-NEXT_PUBLIC_-prefixed duplicates, used only by the local dev scripts in
# scripts/ (generate-test-users.js, generate-test-tokens.js), not by the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# GOOGLE OAUTH (Calendar sync, Drive attachments, Gmail send — server-side)
# ============================================================================
# Setup: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web application). Enable Calendar API, Drive API, Gmail API.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ============================================================================
# GOOGLE DRIVE PICKER (client-side, browser "Elegir de Google Drive" button)
# ============================================================================
# Separate from the server-side OAuth flow above — read directly by client
# code (src/lib/google/picker-client.ts), so must be NEXT_PUBLIC_-prefixed.
# Safe to expose in the client bundle by design (OAuth client IDs are
# public; the Picker key should be restricted by HTTP referrer in Google
# Cloud Console, not kept secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-referrer-restricted-browser-key

# ============================================================================
# RESEND (transactional email)
# ============================================================================
# Setup: https://resend.com → API Keys. Domain must be verified to send
# from NOTIFICATION_FROM_EMAIL's domain.

RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_FROM_EMAIL=notifications@yourdomain.com

# ============================================================================
# SENTRY (error tracking)
# ============================================================================
# Setup: https://sentry.io → Create Project (Next.js) → Client Keys (DSN)

NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePrivateKey@o0.ingest.sentry.io/0

# ============================================================================
# UPSTASH REDIS (rate limiting — src/lib/rate-limit.ts)
# ============================================================================
# Setup: https://upstash.com → Create Database. The Vercel Marketplace
# "Upstash for Redis" integration provisions KV_REST_API_URL/TOKEN instead
# (legacy @vercel/kv naming) — src/lib/rate-limit.ts accepts either pair.
# Without either, rate limiting falls back to a weak in-memory limiter.

UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================================================
# CRON & INTERNAL WEBHOOKS
# ============================================================================

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# (or `?secret=` for external monitors that can't send custom headers) to
# authenticate /api/cron/alert-check.
# Generate: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# Slack/Discord (or similar) incoming webhook URL alert-check posts to when
# a health check fails.
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Shared secret for the internal /api/internal/notify-event and
# /api/internal/sync-calendar-event routes (called by Postgres triggers via
# pg_net, not by end users).
# Generate: openssl rand -base64 32
INTERNAL_NOTIFY_SECRET=your-random-secret-here

# ============================================================================
# AUTH & MISC
# ============================================================================

# Signs/verifies the Google OAuth `state` param (src/lib/google/oauth.ts) —
# unrelated to Supabase Auth's own JWTs.
# Generate: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Base URL used to build absolute links in outgoing emails
# (src/lib/emails/utils.ts). Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NODE_ENV is set automatically by Next.js/Vercel — do not set manually.
